<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <FrameLayout
            android:id="@+id/onboardingHero"
            android:layout_width="216dp"
            android:layout_height="216dp"
            android:importantForAccessibility="no">

            <View
                android:id="@+id/onboardingOuterRing"
                android:layout_width="206dp"
                android:layout_height="206dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_hero_ring_dashed" />

            <View
                android:id="@+id/onboardingMiddleRing"
                android:layout_width="156dp"
                android:layout_height="156dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_onboarding_ring" />

            <FrameLayout
                android:layout_width="94dp"
                android:layout_height="94dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_onboarding_icon">

                <ImageView
                    android:id="@+id/onboardingIcon"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null" />
            </FrameLayout>

            <View
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="35dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/bg_onboarding_dot_active" />
        </FrameLayout>

        <TextView
            android:id="@+id/onboardingStep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.18"
            android:textColor="@color/accent_emerald"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/onboardingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:textColor="@color/ink"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/onboardingBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/ink_2"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
