<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="20dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.16"
            android:text="@string/wb_login_kicker"
            android:textAllCaps="true"
            android:textColor="@color/accent_emerald"
            android:textSize="9sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="serif"
            android:text="@string/wb_login_title"
            android:textColor="@color/ink"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wbLoginStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/wb_login_opening"
            android:textColor="@color/ink_2"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/wbLoginDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:maxLines="7"
            android:textColor="@color/ink_2"
            android:textIsSelectable="true"
            android:textSize="10sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/hair" />

    <WebView
        android:id="@+id/wbLoginWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/wbAutoConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:checked="true"
        android:text="@string/wb_creator_auto_connect" />

    <LinearLayout
        android:id="@+id/wbInvitePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/wbInviteInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/wb_creator_invite_hint"
            android:inputType="textUri"
            android:maxLines="2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/wbInviteSubmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wb_creator_send_invite" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/wbLoginClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/wb_login_cancel" />
</LinearLayout>
